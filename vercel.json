{
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node scripts/build.js public",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/p/(.*)", "destination": "/api/index" },
    { "source": "/dreams", "destination": "/api/index" },
    { "source": "/dreams/(.*)", "destination": "/api/index" },
    { "source": "/updates", "destination": "/updates.html" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "src/**" }
  },
  "schedules": {
    "wake-check": { "schedule": "*/15 * * * *", "path": "/api/wake/check" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
